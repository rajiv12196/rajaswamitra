# Paste this into Streamlit Community Cloud -> App settings -> Secrets
# (replace the key with your own from https://console.groq.com/keys).
# Never commit a real key to GitHub.
RM_PUBLIC_DEMO = "1"
RM_PROVIDER = "openai_compatible"
RM_BASE_URL = "https://api.groq.com/openai/v1"
RM_MODEL = "openai/gpt-oss-20b"
RM_API_KEY = "gsk_your_key_here"
